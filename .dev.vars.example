# 로컬 개발용 시크릿. 이 파일을 `.dev.vars` 로 복사해 값을 채운다.
# 운영 등록: wrangler secret put <NAME>

# /internal/* 릴레이 전용 Bearer 토큰 (§6, §7)
#   생성 예: openssl rand -hex 32
RELAY_TOKEN=change-me-please

# Phase 4 · 한국투자증권 KIS OpenAPI (PRICE_PROVIDER=kis 일 때만 필요)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 도메인 사용 시 https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 로컬에서 Access 헤더 없이 돌릴 때 사용자 식별자 (vars.DEV_USER 로도 지정 가능)
DEV_USER=dev@local
